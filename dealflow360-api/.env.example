# Database
DATABASE_URL="postgresql://dealflow:dealflow_secret@localhost:5432/dealflow360?schema=public"

# JWT
JWT_SECRET="change-me-in-production-use-a-long-random-string"

# Server
PORT=3000
HOST=0.0.0.0

# Email — Nodemailer (no Gmail/SMTP needed for local dev)
# console  = log emails to terminal (default)
# ethereal = free test inbox at https://ethereal.email (needs network)
# smtp     = real SMTP server (set SMTP_* below)
EMAIL_TRANSPORT=console
EMAIL_FROM="DealFlow360 <noreply@dealflow360.local>"

# Only required when EMAIL_TRANSPORT=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# Portal magic-link email (Resend — https://resend.com, free tier)
# Leave RESEND_API_KEY empty for local dev; link is logged + returned in API response instead.
RESEND_API_KEY=
RESEND_FROM_EMAIL="DealFlow360 <onboarding@resend.dev>"
PORTAL_BASE_URL=http://localhost:3000
