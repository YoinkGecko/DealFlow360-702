# Database
DATABASE_URL="postgresql://dealflow:dealflow_secret@localhost:5432/dealflow360?schema=public"

# JWT
JWT_SECRET="change-me-in-production-use-a-long-random-string"

# Server
PORT=3000
HOST=0.0.0.0

# Email — Nodemailer (welcome email on signup)
# console  = log emails to terminal (default)
# ethereal = free test inbox at https://ethereal.email (needs network)
# smtp     = real SMTP server (set SMTP_* below)
EMAIL_TRANSPORT=console
EMAIL_FROM="DealFlow360 <noreply@dealflow360.local>"

# Portal magic-link email (Nodemailer SMTP — same vars as below)
# If SMTP_HOST/USER/PASS are not set, the magic link is logged to the API console
# and returned in the JSON response for local testing.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="DealFlow360 <noreply@dealflow360.local>"
PORTAL_BASE_URL=http://localhost:5173
