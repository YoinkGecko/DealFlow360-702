generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  REP
  MANAGER
  FINANCE
  ADMIN
  CUSTOMER
}

enum QuoteStatus {
  DRAFT
  SENT
  UNDER_NEGOTIATION
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CONFIRMED
}

enum ApprovalDecision {
  PENDING
  APPROVED
  REJECTED
  REVISION_REQUESTED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
}

enum LedgerLineType {
  ONE_TIME_CHARGE
  RECURRING_CHARGE
  PRORATED_CHARGE
  CREDIT
}

enum ChangeRequestType {
  COMMENT
  COUNTER_DISCOUNT
  GENERAL_CHANGE
}

enum ChangeRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         UserRole
  name         String
  createdAt    DateTime @default(now())
}

model Event {
  id            String   @id @default(uuid())
  aggregateId   String
  aggregateType String
  type          String
  payload       Json
  actorUserId   String?
  createdAt     DateTime @default(now())

  @@index([aggregateId])
  @@index([aggregateType, aggregateId])
  @@map("events")
}

model Product {
  id               String                 @id @default(uuid())
  name             String
  category         String
  unitPrice        Decimal                @db.Decimal(12, 2)
  description      String?
  isPromoted       Boolean                @default(false)
  promotionTag     String?
  priceListEntries PriceListEntry[]
  quoteLines       QuoteLine[]
  stockLevels      StockLevel[]
  purchaseCount    ProductPurchaseCount?
  createdAt        DateTime               @default(now())
}

model PriceListEntry {
  id           String  @id @default(uuid())
  productId    String
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerTier String
  price        Decimal @db.Decimal(12, 2)
  currency     String  @default("INR")

  @@unique([productId, customerTier])
}

model CustomerTier {
  id                     String     @id @default(uuid())
  name                   String     @unique
  defaultDiscountCeiling Float
  customers              Customer[]
}

model Customer {
  id             String          @id @default(uuid())
  name           String
  email          String          @default("procurement@acmecorp.test")
  customerTierId String       @map("tierId")
  tier           CustomerTier @relation(fields: [customerTierId], references: [id])
  quotes         Quote[]
  portalSessions PortalSession[]
  createdAt      DateTime        @default(now())
}

model CategoryDiscountCeiling {
  id             String @id @default(uuid())
  category       String
  customerTier   String
  ceilingPercent Float

  @@unique([category, customerTier])
}

model ApprovalChainRule {
  id                String   @id @default(uuid())
  minRiskScore      Float
  maxRiskScore      Float
  requiredApprovers String[]
}

model Quote {
  id               String                 @id @default(uuid())
  customerId       String
  customer         Customer               @relation(fields: [customerId], references: [id])
  repUserId        String
  status           QuoteStatus            @default(DRAFT)
  blendedRiskScore Float?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  lines            QuoteLine[]
  approvals        Approval[]
  subscriptions    Subscription[]
  ledgerLines      LedgerLine[]
  stageTransitions QuoteStageTransition[]
  changeRequests   ChangeRequest[]
  portalSessions   PortalSession[]
}

model QuoteStageTransition {
  id             String   @id @default(uuid())
  quoteId        String
  quote          Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  fromStatus     String
  toStatus       String
  transitionedAt DateTime @default(now())

  @@index([quoteId, transitionedAt])
  @@index([fromStatus])
}

model QuoteLine {
  id              String       @id @default(uuid())
  quoteId         String
  quote           Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId       String
  product         Product      @relation(fields: [productId], references: [id])
  quantity        Int
  unitPrice       Decimal      @db.Decimal(12, 2)
  discountPercent Float
  lineValue       Decimal       @db.Decimal(12, 2)
  allocations     Allocation[]
  backorders      Backorder[]
  changeRequests  ChangeRequest[]
}

model Approval {
  id             String           @id @default(uuid())
  quoteId        String
  quote          Quote            @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  approverRole   String
  approverUserId String?
  decision       ApprovalDecision @default(PENDING)
  reason         String?
  decidedAt      DateTime?
  sortOrder      Int              @default(0)
}

// Per-warehouse flat shipping rate keeps allocator logic simple.
// Per-product shipping cost per warehouse is a realistic extension but out of scope here.
model Warehouse {
  id                   String        @id @default(uuid())
  name                 String
  shippingCostPerUnit  Float
  stockLevels          StockLevel[]
  allocations          Allocation[]
  createdAt            DateTime      @default(now())
}

model StockLevel {
  id                String    @id @default(uuid())
  warehouseId       String
  warehouse         Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productId         String
  product           Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantityAvailable Int

  @@unique([warehouseId, productId])
}

model Allocation {
  id                String    @id @default(uuid())
  quoteLineId       String
  quoteLine         QuoteLine @relation(fields: [quoteLineId], references: [id], onDelete: Cascade)
  warehouseId       String
  warehouse         Warehouse @relation(fields: [warehouseId], references: [id])
  quantityAllocated Int
  createdAt         DateTime  @default(now())
}

model Backorder {
  id                  String    @id @default(uuid())
  quoteLineId         String
  quoteLine           QuoteLine @relation(fields: [quoteLineId], references: [id], onDelete: Cascade)
  quantityBackordered Int
  createdAt           DateTime  @default(now())
  fulfilledAt         DateTime?
}

model SubscriptionPlan {
  id               String         @id @default(uuid())
  name             String
  billingCycleDays Int
  pricePerUnit     Decimal        @db.Decimal(12, 2)
  subscriptions    Subscription[]
}

model Subscription {
  id             String             @id @default(uuid())
  quoteId        String
  quote          Quote              @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  planId         String
  plan           SubscriptionPlan   @relation(fields: [planId], references: [id])
  quantity       Int
  cycleStartDate DateTime
  cycleEndDate   DateTime
  status         SubscriptionStatus @default(ACTIVE)
  ledgerLines    LedgerLine[]
}

model LedgerLine {
  id             String          @id @default(uuid())
  quoteId        String
  quote          Quote           @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription?   @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  type           LedgerLineType
  amount         Decimal         @db.Decimal(12, 2)
  description    String
  createdAt      DateTime        @default(now())
}

model ProductCoOccurrence {
  id                String   @id @default(uuid())
  productIdA        String
  productIdB        String
  coOccurrenceCount Int
  updatedAt         DateTime @updatedAt

  @@unique([productIdA, productIdB])
}

model ProductPurchaseCount {
  id              String  @id @default(uuid())
  productId       String  @unique
  product         Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  totalOrderCount Int
}

model PortalSession {
  id         String    @id @default(uuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  quoteId    String
  quote      Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  token      String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([quoteId])
}

model ChangeRequest {
  id                      String              @id @default(uuid())
  quoteId                 String
  quote                   Quote               @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteLineId             String?
  quoteLine               QuoteLine?          @relation(fields: [quoteLineId], references: [id], onDelete: SetNull)
  type                    ChangeRequestType
  proposedDiscountPercent Float?
  message                 String?
  status                  ChangeRequestStatus @default(PENDING)
  createdAt               DateTime            @default(now())
  resolvedAt              DateTime?

  @@index([quoteId, status])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  quoteId   String?
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}
