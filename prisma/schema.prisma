generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  REP
  MANAGER
  FINANCE
  ADMIN
  CUSTOMER
}

enum QuoteStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CONFIRMED
}

enum ApprovalDecision {
  PENDING
  APPROVED
  REJECTED
  REVISION_REQUESTED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         UserRole
  name         String
  createdAt    DateTime @default(now())
}

model Event {
  id            String   @id @default(uuid())
  aggregateId   String
  aggregateType String
  type          String
  payload       Json
  actorUserId   String?
  createdAt     DateTime @default(now())

  @@index([aggregateId])
  @@index([aggregateType, aggregateId])
  @@map("events")
}

model Product {
  id               String           @id @default(uuid())
  name             String
  category         String
  unitPrice        Decimal          @db.Decimal(12, 2)
  description      String?
  priceListEntries PriceListEntry[]
  quoteLines       QuoteLine[]
  createdAt        DateTime         @default(now())
}

model PriceListEntry {
  id           String  @id @default(uuid())
  productId    String
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerTier String
  price        Decimal @db.Decimal(12, 2)
  currency     String  @default("INR")

  @@unique([productId, customerTier])
}

model CustomerTier {
  id                     String     @id @default(uuid())
  name                   String     @unique
  defaultDiscountCeiling Float
  customers              Customer[]
}

model Customer {
  id     String       @id @default(uuid())
  name   String
  tierId String
  tier   CustomerTier @relation(fields: [tierId], references: [id])
  quotes Quote[]
}

model CategoryDiscountCeiling {
  id             String @id @default(uuid())
  category       String
  customerTier   String
  ceilingPercent Float

  @@unique([category, customerTier])
}

model ApprovalChainRule {
  id                String   @id @default(uuid())
  minRiskScore      Float
  maxRiskScore      Float
  requiredApprovers String[]
}

model Quote {
  id               String      @id @default(uuid())
  customerId       String
  customer         Customer    @relation(fields: [customerId], references: [id])
  repUserId        String
  status           QuoteStatus @default(DRAFT)
  blendedRiskScore Float?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  lines            QuoteLine[]
  approvals        Approval[]
}

model QuoteLine {
  id              String  @id @default(uuid())
  quoteId         String
  quote           Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId       String
  product         Product @relation(fields: [productId], references: [id])
  quantity        Int
  unitPrice       Decimal @db.Decimal(12, 2)
  discountPercent Float
  lineValue       Decimal @db.Decimal(12, 2)
}

model Approval {
  id             String           @id @default(uuid())
  quoteId        String
  quote          Quote            @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  approverRole   String
  approverUserId String?
  decision       ApprovalDecision @default(PENDING)
  reason         String?
  decidedAt      DateTime?
  sortOrder      Int              @default(0)
}
